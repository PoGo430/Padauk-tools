<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Padauk" />
		<Option makefile_is_custom="1" />
		<Option pch_mode="2" />
		<Option compiler="sdcc" />
		<!-- All settings (DEVICE, F_CPU, ...) are in the Makefile.
		     Pick a build target in the toolbar, then press Build:
		       Build    -> make            (compile + ROM/RAM usage)
		       Program  -> make program    (compile + write the chip)
		       Run      -> make run        (power chip, show serial output) -->
		<Build>
			<Target title="Build">
				<Option type="4" />
				<Option compiler="sdcc" />
				<MakeCommands>
					<Build command="$make all" />
					<CompileFile command="$make all" />
					<Clean command="$make clean" />
					<DistClean command="$make distclean" />
					<AskRebuildNeeded command="" />
					<SilentBuild command="$make all &gt; $(CMD_NULL)" />
				</MakeCommands>
			</Target>
			<Target title="Program">
				<Option type="4" />
				<Option compiler="sdcc" />
				<MakeCommands>
					<Build command="$make program" />
					<CompileFile command="$make all" />
					<Clean command="$make clean" />
					<DistClean command="$make distclean" />
					<AskRebuildNeeded command="" />
					<SilentBuild command="$make program &gt; $(CMD_NULL)" />
				</MakeCommands>
			</Target>
			<Target title="Run">
				<Option type="4" />
				<Option compiler="sdcc" />
				<MakeCommands>
					<Build command="$make run" />
					<CompileFile command="$make all" />
					<Clean command="$make clean" />
					<DistClean command="$make distclean" />
					<AskRebuildNeeded command="" />
					<SilentBuild command="$make run" />
				</MakeCommands>
			</Target>
		</Build>
		<Unit filename="Makefile" />
		<Unit filename="board.h" />
		<Unit filename="main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions />
	</Project>
</CodeBlocks_project_file>
