#!/usr/bin/env python3
"""
pdk - Padauk project helper (SDCC + Easy PDK programmer).

  pdk new blinky                    new project (PFS154) and open it in VS Code
  pdk new hello -d PFS122 -e serial_hello
  pdk build | flash | monitor       build / write the chip / show its serial output
  pdk flash -m                      write, then monitor
  pdk set device=PMS150C clock=1M vdd=3.3
  pdk doctor                        check SDCC, easypdkprog and the programmer
  pdk gui                           graphical interface (needs PyQt5)

Run inside a project folder (or any subfolder). `pdk help <command>` for details.
Only needs Python 3.8+ and make; everything else is done by the project's Makefile.
"""
import argparse
import os
import re
import shutil
import subprocess
import sys
import time

REPO = os.path.dirname(os.path.realpath(__file__))
TEMPLATE = os.path.join(REPO, "template")
EXAMPLES = os.path.join(REPO, "examples")
MAIN_CHIPS = ("PFS154", "PFS122", "PMS150C")   # listed first
DEV_BRANCH_ONLY = ("PFS121", "PFS122", "PFS123", "PFS172B", "PFS173B")

# ----------------------------------------------------------------------------
# Output helpers
# ----------------------------------------------------------------------------
COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None and os.name != "nt"


def _c(code, text):
    return f"\033[{code}m{text}\033[0m" if COLOR else text


def ok(msg):
    print(f"  {_c('32', '[ok]')} {msg}")


def warn(msg):
    print(f"  {_c('33', '[!!]')} {msg}")


def bad(msg):
    print(f"  {_c('31', '[XX]')} {msg}")


def info(msg):
    print(f"       {msg}")


def die(msg, code=1):
    print(_c("31", "error: ") + msg, file=sys.stderr)
    sys.exit(code)


# ----------------------------------------------------------------------------
# Template / project helpers
# ----------------------------------------------------------------------------
def load_devices(makefile=None):
    """Device table from a Makefile: {name: (arch, rom_words, ram_bytes, mtp|otp)}."""
    path = makefile or os.path.join(TEMPLATE, "Makefile")
    devices = {}
    with open(path) as f:
        for m in re.finditer(r"^DEV_(\w+)\s*:=\s*(pdk1[345])\s+(\d+)\s+(\d+)\s+(mtp|otp)", f.read(), re.M):
            devices[m.group(1)] = (m.group(2), int(m.group(3)), int(m.group(4)), m.group(5))
    return devices


SETTING_RE = r"^({name}[ \t]*\?=[ \t]*)([^#\s]*)"


def read_setting(text, name):
    m = re.search(SETTING_RE.format(name=name), text, re.M)
    return m.group(2) if m else None


def write_setting(text, name, value):
    pattern = re.compile(SETTING_RE.format(name=name), re.M)
    if not pattern.search(text):
        die(f"Makefile has no '{name} ?=' line")
    return pattern.sub(lambda m: m.group(1) + value, text, count=1)


def find_project(start=None):
    """Walk up from the current folder to the project Makefile."""
    path = os.path.abspath(start or os.getcwd())
    while True:
        mk = os.path.join(path, "Makefile")
        if os.path.isfile(mk):
            with open(mk) as f:
                if "DEV_PFS154" in f.read():
                    return path
        parent = os.path.dirname(path)
        if parent == path:
            return None
        path = parent


def require_project(a=None):
    project = getattr(a, "project", None) or find_project()
    if not project:
        die("not inside a Padauk project. Create one with: pdk new <name>")
    return project


def project_settings(project):
    with open(os.path.join(project, "Makefile")) as f:
        text = f.read()
    return {k: read_setting(text, k) for k in ("PROJECT_NAME", "DEVICE", "F_CPU", "TARGET_VDD_MV")}


def write_intellisense(project, devices):
    """Same content as `make intellisense`, so VS Code is right before the first build."""
    s = project_settings(project)
    arch = devices.get(s["DEVICE"], ("pdk14",))[0]
    os.makedirs(os.path.join(project, ".vscode"), exist_ok=True)
    rev = "13081"
    if shutil.which("sdcc"):
        m = re.search(r"#(\d+)", run_quiet(["sdcc", "--version"]))
        rev = m.group(1) if m else rev
    lines = [
        "// Generated by the Makefile from DEVICE / F_CPU / TARGET_VDD_MV. Do not edit.",
        "// Lets VS Code IntelliSense show the registers of the chip you build for.",
        f"#define {s['DEVICE']} 1",
        f"#define __SDCC_{arch} 1",
        f"#define __SDCC_REVISION {rev}",
        f"#define F_CPU {s['F_CPU']}",
        f"#define TARGET_VDD_MV {s['TARGET_VDD_MV']}",
    ]
    with open(os.path.join(project, ".vscode", "pdk_config.h"), "w") as f:
        f.write("\n".join(lines) + "\n")


def run_quiet(cmd, timeout=15):
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout)
        return p.stdout.decode(errors="replace")
    except (OSError, subprocess.TimeoutExpired):
        return ""


def make(project, *targets, extra=()):
    if not shutil.which("make"):
        die("'make' not found. Run: pdk doctor")
    cmd = ["make", "--no-print-directory", *targets, *extra]
    try:
        return subprocess.call(cmd, cwd=project)
    except KeyboardInterrupt:
        return 130


def parse_frequency(v):
    m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*(m|mhz|k|khz|hz)?", v.strip().lower())
    if not m:
        die(f"can't read clock '{v}'. Examples: 8M, 500k, 1000000")
    num, unit = float(m.group(1)), (m.group(2) or "hz")
    mult = 1_000_000 if unit.startswith("m") else 1000 if unit.startswith("k") else 1
    return str(int(num * mult))


def parse_voltage(v):
    m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*(mv|v)?", v.strip().lower())
    if not m:
        die(f"can't read voltage '{v}'. Examples: 5, 3.3V, 3300mV")
    num = float(m.group(1))
    if m.group(2) == "mv" or (m.group(2) is None and num > 100):
        return str(int(num))
    return str(int(round(num * 1000)))


# ----------------------------------------------------------------------------
# Commands
# ----------------------------------------------------------------------------
def cmd_new(a):
    devices = load_devices()
    device = a.device.upper()
    if device not in devices:
        die(f"unknown device '{a.device}'. See: pdk devices")
    if a.example and not os.path.isfile(os.path.join(EXAMPLES, a.example, "main.c")):
        die(f"unknown example '{a.example}'. See: pdk examples")
    dest = os.path.abspath(a.name)
    if os.path.exists(dest):
        die(f"{dest} already exists")
    name = re.sub(r"[^A-Za-z0-9_-]", "_", os.path.basename(dest))

    shutil.copytree(TEMPLATE, dest, ignore=shutil.ignore_patterns(".build", ".output"))
    if a.example:
        shutil.copy(os.path.join(EXAMPLES, a.example, "main.c"), os.path.join(dest, "main.c"))

    mk = os.path.join(dest, "Makefile")
    with open(mk) as f:
        text = f.read()
    text = write_setting(text, "PROJECT_NAME", name)
    text = write_setting(text, "DEVICE", device)
    with open(mk, "w") as f:
        f.write(text)
    cbp = os.path.join(dest, "padauk.cbp")
    if os.path.isfile(cbp):
        os.replace(cbp, os.path.join(dest, f"{name}.cbp"))
    write_intellisense(dest, devices)

    arch, rom, ram, mem = devices[device]
    print(f"Created {dest}")
    info(f"{device}: {arch}, {rom} words ROM, {ram} bytes RAM, {'flash' if mem == 'mtp' else 'OTP (write once!)'}"
         + (f", example: {a.example}" if a.example else ""))
    if device in DEV_BRANCH_ONLY:
        warn(f"{device} needs easypdkprog from the development branch. See docs/setup.md")
    shown = os.path.relpath(dest)
    if shown.startswith(".."):
        shown = dest
    if a.no_code:
        print(f"\n  cd {shown} && pdk build")
    elif shutil.which("code"):
        subprocess.call(["code", dest])
    else:
        print(f"\n  Open the folder in VS Code (code {shown}), then Ctrl+Shift+B to build.")


def cmd_make_target(target):
    def run(a):
        project = require_project()
        extra = list(getattr(a, "make_args", []) or [])
        sys.exit(make(project, target, extra=extra))
    return run


def cmd_flash(a):
    project = require_project()
    s = project_settings(project)
    devices = load_devices(os.path.join(project, "Makefile"))
    if devices.get(s["DEVICE"], ("", 0, 0, ""))[3] == "otp" and not a.yes:
        if not sys.stdin.isatty():
            die(f"{s['DEVICE']} is OTP (write once). Add --yes to confirm.")
        reply = input(f"{s['DEVICE']} is one-time programmable. Write it now? [y/N] ")
        if reply.strip().lower() not in ("y", "yes"):
            sys.exit(1)
    targets = ["program", "run"] if a.monitor else ["program"]
    sys.exit(make(project, *targets, extra=["OTP_OK=1", *a.make_args]))


def cmd_set(a):
    project = require_project()
    devices = load_devices(os.path.join(project, "Makefile"))
    keys = {
        "device": "DEVICE", "chip": "DEVICE",
        "clock": "F_CPU", "fcpu": "F_CPU", "f_cpu": "F_CPU", "freq": "F_CPU",
        "vdd": "TARGET_VDD_MV", "voltage": "TARGET_VDD_MV", "target_vdd_mv": "TARGET_VDD_MV",
        "name": "PROJECT_NAME", "project_name": "PROJECT_NAME",
    }
    if not a.pairs:
        return cmd_config(a)
    mk = os.path.join(project, "Makefile")
    with open(mk) as f:
        text = f.read()
    for pair in a.pairs:
        if "=" not in pair:
            die(f"expected key=value, got '{pair}'. Keys: device, clock, vdd, name")
        key, value = pair.split("=", 1)
        var = keys.get(key.strip().lower())
        if not var:
            die(f"unknown setting '{key}'. Keys: device, clock, vdd, name")
        if var == "DEVICE":
            value = value.strip().upper()
            if value not in devices:
                die(f"unknown device '{value}'. See: pdk devices")
            if value in DEV_BRANCH_ONLY:
                warn(f"{value} needs easypdkprog from the development branch (docs/setup.md)")
        elif var == "F_CPU":
            value = parse_frequency(value)
        elif var == "TARGET_VDD_MV":
            value = parse_voltage(value)
            if not 1800 <= int(value) <= 5500:
                die(f"{value} mV is outside 1.8-5.5 V")
        else:
            value = re.sub(r"[^A-Za-z0-9_-]", "_", value.strip())
        text = write_setting(text, var, value)
    with open(mk, "w") as f:
        f.write(text)
    write_intellisense(project, devices)
    cmd_config(a)


def cmd_device(a):
    if a.name:
        a.pairs = [f"device={a.name}"]
        return cmd_set(a)
    cmd_config(a)


def cmd_config(a):
    project = require_project(a)
    s = project_settings(project)
    devices = load_devices(os.path.join(project, "Makefile"))
    arch, rom, ram, mem = devices.get(s["DEVICE"], ("?", 0, 0, "?"))
    print(f"  project  {s['PROJECT_NAME']}   ({project})")
    print(f"  device   {s['DEVICE']}   {arch}, {rom} words ROM, {ram} bytes RAM, "
          f"{'flash' if mem == 'mtp' else 'OTP (write once)'}")
    print(f"  clock    {human_hz(int(s['F_CPU']))}")
    print(f"  vdd      {int(s['TARGET_VDD_MV']) / 1000:.2f} V")


def cmd_devices(a):
    devices = load_devices()
    print(f"  {'DEVICE':<9}{'ARCH':<7}{'ROM':>6}{'RAM':>6}  MEMORY")
    for name in sorted(devices, key=lambda n: (n not in MAIN_CHIPS, n)):
        arch, rom, ram, mem = devices[name]
        note = []
        if name in DEV_BRANCH_ONLY:
            note.append("needs dev easypdkprog")
        print(f"  {name:<9}{arch:<7}{rom:>6}{ram:>6}  {'flash' if mem == 'mtp' else 'OTP  '}"
              + (f"   ({', '.join(note)})" if note else ""))


def cmd_examples(a):
    for name in sorted(os.listdir(EXAMPLES)):
        path = os.path.join(EXAMPLES, name, "main.c")
        if not os.path.isfile(path):
            continue
        with open(path) as f:
            m = re.search(r"\*\s*\w+\s*-\s*(.+)", f.read())
        print(f"  {name:<16}{m.group(1).strip() if m else ''}")
    print("\n  pdk new <name> -e <example>")


def human_hz(hz):
    if hz >= 1_000_000 and hz % 1000 == 0:
        return f"{hz / 1_000_000:g} MHz"
    if hz >= 1000:
        return f"{hz / 1000:g} kHz"
    return f"{hz} Hz"


def version_tuple(text):
    m = re.search(r"(\d+)\.(\d+)\.(\d+)", text)
    return tuple(int(x) for x in m.groups()) if m else None


def cmd_doctor(a):
    problems = 0
    project = getattr(a, "project", None) or find_project()
    device = project_settings(project)["DEVICE"] if project else None

    print("Toolchain")
    if shutil.which("make"):
        ok(run_quiet(["make", "--version"]).splitlines()[0])
    else:
        bad("make not found (Linux: apt install make, macOS: xcode-select --install, Windows: MSYS2)")
        problems += 1
    if shutil.which("sdcc"):
        out = run_quiet(["sdcc", "--version"])
        ver = version_tuple(out)
        if "pdk14" not in out:
            bad("sdcc found but without Padauk (pdk13/14/15) support")
            problems += 1
        elif ver and ver < (4, 2, 0):
            warn(f"sdcc {'.'.join(map(str, ver))} is old, 4.2.0 or newer recommended")
        else:
            ok(f"sdcc {'.'.join(map(str, ver)) if ver else '?'} with pdk13/14/15")
    else:
        bad("sdcc not found (Linux: apt install sdcc, macOS: brew install sdcc, Windows: sdcc.sourceforge.net)")
        problems += 1
    for tool in ("makebin", "awk"):
        if shutil.which(tool):
            ok(tool)
        else:
            bad(f"{tool} not found ({'comes with sdcc' if tool == 'makebin' else 'install gawk or mawk'})")
            problems += 1

    print("\nProgrammer")
    prog = os.environ.get("EASYPDKPROG") or "easypdkprog"
    if shutil.which(prog):
        ver = run_quiet([prog, "--version"]).strip() or "unknown version"
        supported = set(re.findall(r"^\s*([A-Z0-9]+)\s+\(0x", run_quiet([prog, "list"]), re.M))
        dev_build = "-g" in ver and not ver.endswith("1.3")
        ok(f"{ver}" + ("  (development build)" if dev_build else ""))
        for name in ([device] if device else list(MAIN_CHIPS)):
            if name in supported:
                ok(f"supports {name}")
            elif name in DEV_BRANCH_ONLY:
                bad(f"does not know {name}: build the development branch with tools/build-easypdkprog-dev.sh")
                problems += 1
            else:
                warn(f"does not list {name}")
        if a.probe:
            print()
            out = run_quiet([prog, "probe"], timeout=30)
            for line in out.strip().splitlines():
                info(line)
            if "No programmer found" in out:
                bad("no programmer found: check the USB cable (and firmware version, see docs/setup.md)")
                problems += 1
            elif "not found" in out.lower() or "error" in out.lower():
                warn("programmer answered, see the message above")
    else:
        bad("easypdkprog not found: https://github.com/free-pdk/easy-pdk-programmer-software/releases "
            "(PFS122: tools/build-easypdkprog-dev.sh)")
        problems += 1

    if sys.platform.startswith("linux"):
        ports = sorted(p for p in os.listdir("/dev") if p.startswith("ttyACM"))
        for p in ports:
            full = "/dev/" + p
            if os.access(full, os.R_OK | os.W_OK):
                ok(f"{full} accessible")
            else:
                bad(f"{full} not accessible: sudo usermod -aG dialout $USER, then log in again")
                problems += 1
        if not ports:
            warn("no /dev/ttyACM* device: is the programmer plugged in?")
    if not a.probe:
        info("(pdk doctor --probe also talks to the programmer)")

    print("\nEditor")
    if shutil.which("code"):
        ok("VS Code 'code' command available")
    else:
        warn("'code' command not on PATH (VS Code: Ctrl+Shift+P > 'Shell Command: Install code in PATH')")

    if project:
        print(f"\nProject: {project}")
        cmd_config(a)
    print()
    print(_c("32", "All good.") if problems == 0 else _c("31", f"{problems} problem(s) found."))
    sys.exit(1 if problems else 0)


def cmd_upgrade(a):
    """Refresh include/, .vscode/ and the Makefile from the template, keeping your settings and code."""
    project = require_project(a)
    if os.path.realpath(project) == os.path.realpath(TEMPLATE):
        die("this is the template itself")
    old = project_settings(project)
    with open(os.path.join(project, "Makefile")) as f:
        old_mk = f.read()
    backup = os.path.join(project, ".pdk-backup", time.strftime("%Y%m%d-%H%M%S"))
    os.makedirs(backup)
    for item in ("Makefile", "include", ".vscode"):
        src = os.path.join(project, item)
        if os.path.isdir(src):
            shutil.copytree(src, os.path.join(backup, item))
        elif os.path.isfile(src):
            shutil.copy2(src, backup)

    shutil.rmtree(os.path.join(project, "include"), ignore_errors=True)
    shutil.copytree(os.path.join(TEMPLATE, "include"), os.path.join(project, "include"))
    for f in os.listdir(os.path.join(TEMPLATE, ".vscode")):
        if f != "pdk_config.h":
            shutil.copy(os.path.join(TEMPLATE, ".vscode", f), os.path.join(project, ".vscode", f))
    with open(os.path.join(TEMPLATE, "Makefile")) as f:
        text = f.read()
    for k, v in old.items():
        if v:
            text = write_setting(text, k, v)
    # keep any other customised "?=" settings (SOURCES, PROG_PORT, ...)
    for k in ("OPT_FLAGS", "EXTRA_CFLAGS", "SOURCES", "EASYPDKPROG", "PROG_PORT", "PROG_FLAGS", "PROG_ICNAME"):
        v = re.search(rf"^{k}[ \t]*\?=[ \t]*(.*?)[ \t]*(#.*)?$", old_mk, re.M)
        if v and v.group(1):
            text = re.sub(rf"^({k}[ \t]*\?=)[^\n]*", lambda m: m.group(1) + " " + v.group(1), text, count=1, flags=re.M)
    with open(os.path.join(project, "Makefile"), "w") as f:
        f.write(text)
    write_intellisense(project, load_devices())
    print(f"Upgraded {project}")
    info("updated: Makefile (settings kept), include/, .vscode/")
    info(f"backup:  {os.path.relpath(backup, project)}")
    info("your main.c, board.h and src/ were not touched")


def cmd_gui(a):
    gui = os.path.join(REPO, "PadaukBuilder", "Padauk Tools.py")
    try:
        import PyQt5  # noqa: F401
    except ImportError:
        die("the GUI needs PyQt5:  pip install PyQt5")
    project = find_project()
    sys.exit(subprocess.call([sys.executable, gui] + ([project] if project else [])))


def cmd_install(a):
    me = os.path.realpath(__file__)
    if os.name == "nt":
        print(f"On Windows run it as:  py \"{me}\" <command>")
        print(f"or add {REPO} to your PATH and use 'py -m' style wrappers.")
        return
    bindir = os.path.expanduser(a.bindir)
    os.makedirs(bindir, exist_ok=True)
    link = os.path.join(bindir, "pdk")
    if os.path.lexists(link):
        os.remove(link)
    os.symlink(me, link)
    print(f"Linked {link} -> {me}")
    if bindir not in os.environ.get("PATH", "").split(os.pathsep):
        warn(f"{bindir} is not on your PATH. Add to ~/.bashrc:  export PATH=\"{bindir}:$PATH\"")


# ----------------------------------------------------------------------------
def main():
    p = argparse.ArgumentParser(prog="pdk", description=__doc__.split("\n\n")[0].strip(),
                                formatter_class=argparse.RawDescriptionHelpFormatter,
                                epilog="Commands that run make accept extra make arguments, e.g.  pdk build DEVICE=PMS150C")
    sub = p.add_subparsers(dest="command", metavar="<command>")

    s = sub.add_parser("new", help="create a project from the template")
    s.add_argument("name", help="folder to create")
    s.add_argument("-d", "--device", default="PFS154", help="chip (default PFS154, see: pdk devices)")
    s.add_argument("-e", "--example", help="start from examples/<name>/main.c (see: pdk examples)")
    s.add_argument("--no-code", action="store_true", help="don't open VS Code")
    s.set_defaults(func=cmd_new)

    for name, target, helptext in [
        ("build", "all", "compile and show ROM/RAM usage"),
        ("monitor", "run", "power the chip, show its serial output (PA7). Ctrl+C to stop"),
        ("probe", "probe", "detect the chip in the programmer"),
        ("erase", "erase", "erase a flash chip"),
        ("read", "read", "read the chip into .output/"),
        ("clean", "clean", "delete build output"),
    ]:
        s = sub.add_parser(name, help=helptext)
        s.add_argument("make_args", nargs="*", help="extra make arguments, e.g. DEVICE=PMS150C")
        s.set_defaults(func=cmd_make_target(target))

    s = sub.add_parser("flash", help="build and write the chip")
    s.add_argument("-m", "--monitor", action="store_true", help="monitor serial output afterwards")
    s.add_argument("-y", "--yes", action="store_true", help="don't ask before writing an OTP chip")
    s.add_argument("make_args", nargs="*")
    s.set_defaults(func=cmd_flash)

    s = sub.add_parser("set", help="change settings: device=PFS122 clock=4M vdd=3.3")
    s.add_argument("pairs", nargs="*")
    s.set_defaults(func=cmd_set)

    s = sub.add_parser("device", help="show or change the chip")
    s.add_argument("name", nargs="?")
    s.set_defaults(func=cmd_device)

    sub.add_parser("config", help="show the project settings").set_defaults(func=cmd_config)
    sub.add_parser("devices", help="list supported chips").set_defaults(func=cmd_devices)
    sub.add_parser("examples", help="list examples").set_defaults(func=cmd_examples)

    s = sub.add_parser("doctor", help="check toolchain, programmer and project")
    s.add_argument("--probe", action="store_true", help="also ask the programmer what's in the socket")
    s.set_defaults(func=cmd_doctor)

    sub.add_parser("upgrade", help="refresh include/, .vscode/ and Makefile from the template (keeps settings)") \
        .set_defaults(func=cmd_upgrade)

    sub.add_parser("gui", help="open the graphical interface (needs PyQt5)").set_defaults(func=cmd_gui)

    s = sub.add_parser("install", help="put 'pdk' on your PATH (symlink in ~/.local/bin)")
    s.add_argument("--bindir", default="~/.local/bin")
    s.set_defaults(func=cmd_install)

    s = sub.add_parser("help", help="show help for a command")
    s.add_argument("topic", nargs="?")

    a = p.parse_args()
    if a.command in (None, "help"):
        topic = getattr(a, "topic", None)
        if topic and topic in sub.choices:
            sub.choices[topic].print_help()
        else:
            print(__doc__.strip())
            print()
            p.print_help()
        return
    a.func(a)


if __name__ == "__main__":
    main()
